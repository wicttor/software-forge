{
  "name": "software-forge",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/wicttor/software-forge.git"
  },
  "homepage": "https://wicttor.com/software-forge",
  "author": {
    "email": "picanco@wicttor.com",
    "name": "Wicttor Picanco",
    "url": "https://wicttor.com"
  },
  "private": false,
  "type": "module",
  "description": "A small, visual, runtime-agnostic software factory: planner, builder, reviewers and approver driven by an orchestrator (Claude Code skill included).",
  "license": "MIT",
  "keywords": [
    "software-forge",
    "software-factory",
    "claude-code",
    "claude-code-skill",
    "ai-agents",
    "agentic",
    "multi-agent",
    "orchestrator",
    "code-review",
    "tdd",
    "git-worktree",
    "conventional-commits",
    "cli",
    "npx",
    "dashboard"
  ],
  "bin": {
    "software-forge": "bin/software-forge.mjs"
  },
  "files": [
    "bin",
    "src",
    "template",
    "LICENSE",
    "dashboard/dist",
    "dashboard/fixtures",
    "README.md"
  ],
  "scripts": {
    "factory": "node bin/software-forge.mjs",
    "test": "node --test test/*.test.mjs",
    "dashboard": "npm --prefix dashboard run dev",
    "dashboard:install": "npm --prefix dashboard ci",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:preview": "npm --prefix dashboard run preview",
    "prepack": "node scripts/ensure-dashboard.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
